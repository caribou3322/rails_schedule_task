<% if post.errors.any? %>
  <div style="color: red;">
    <ul>
      <% post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: post, local: true do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %><br>
    <%= f.date_field :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %><br>
    <%= f.date_field :end_date %>
  </div>

  <div>
    <%= f.check_box :all_day %>
    <%= f.label :all_day, "終日の場合はチェックを入れます" %>
  </div>

  <div>
    <%= f.label :body, "スケジュールメモ" %><br>
    <%= f.text_area :body %>
  </div>

  <div>
    <%= f.submit "保存" %>
  </div>
<% end %>
